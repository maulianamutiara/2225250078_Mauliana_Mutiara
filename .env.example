# Salin file ini menjadi ".env" (untuk npm run dev di laptop), lalu isi nilainya.
# File ".env" TIDAK ikut ke GitHub (sudah ada di .gitignore).
# Di Vercel, isi variabel yang sama di: Project → Settings → Environment Variables.

# Wajib: kunci API dari platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=

# Opsional (biarkan kosong untuk nilai bawaan)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Opsional: kode akses kelas. Jika diisi, siswa/guru memasukkan kode ini di ⚙️ Pengaturan aplikasi.
AI_ACCESS_CODE=

# Opsional: origin lain yang boleh memakai backend ini (dipisah koma),
# mis. versi GitHub Pages: https://maulianamutiara.github.io
ALLOWED_ORIGINS=

# --- Alternatif GRATIS (OpenRouter) ---
# DEEPSEEK_API_KEY=sk-or-v1-...            (kunci dari openrouter.ai → Keys)
# DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
# DEEPSEEK_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,baidu/ernie-5.5-flash-preview:free
# (beberapa model dipisah koma = cadangan otomatis bila model pertama sibuk; batas ±50 pertanyaan/hari)
